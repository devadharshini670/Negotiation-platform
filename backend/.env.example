# Copy this file to `.env` (never commit `.env`) and fill in Groq and/or Gemini. Placeholders only.
# With no key set, the platform runs fully in Mock / Rule-Based mode.
# This file also holds account/session settings further down.
#
# Only two LLM providers are supported: Groq and Google Gemini. You choose one in Agent Configuration;
# the chosen provider is the one used (it is never swapped for the other automatically).

# ── Groq ── create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here 
# Leave GROQ_MODEL blank: the server asks Groq which models your key can use and picks a working one
# (the result is shown in the UI). Set it only to force a specific model from https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile


# ── Google Gemini ── create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Leave GEMINI_MODEL blank for automatic selection from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# Per-request timeout for real LLM calls (seconds). Timeouts and network errors are retried twice before a turn is marked as failed.
LLM_TIMEOUT_SECONDS=45

# ── Accounts ──
# "development" enables local-only conveniences (the Dev Outbox at /dev-outbox.html while no SMTP
# server is configured, and setup hints on disabled Google/GitHub buttons). Leave it unset or set it
# to "production" for any real deployment: there are then no development endpoints at all.
APP_ENV=development

# Signs session cookies. Set a fixed value in any real deployment; otherwise a
# random key is generated at startup and all sessions are invalidated on restart.
FLASK_SECRET_KEY=

# Public origin of the app (no trailing slash). Used for links in emails and as the default for the
# OAuth callback URLs. REQUIRED in production, e.g. https://negotiate.example.com
# (an https:// value also turns on the Secure flag for the session cookie).
APP_BASE_URL=
# SESSION_COOKIE_SECURE=1

# Real email delivery for verification/reset links. In development, leave all blank to use the
# local Dev Outbox instead. In production, email/password sign-up needs these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Sign in with Google / GitHub (real OAuth 2.0 — see README "Social sign-in") ──
# Leave a pair blank to hide/disable that provider; the app runs fine without them.
# The redirect URIs must match, character for character, what you register with the provider, and
# you must browse the app on the same host (127.0.0.1 vs localhost) as the URI you registered.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

GITHUB_CLIENT_ID=Ov23liibyv9aMbF6RQez
GITHUB_CLIENT_SECRET=353b495c410ab01f9fa45292091faeb6af2ebe32
GITHUB_REDIRECT_URI=http://127.0.0.1:5000/api/auth/github/callback

# Server
PORT=5000
FLASK_DEBUG=0
